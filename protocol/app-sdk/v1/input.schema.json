{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppInput",
  "description": "Debug-only POST /v1/input on loopback, with the per-launch bearer secret. Commands run inside one app and one window. Unsupported commands return an explicit refusal. No global events or activation.",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "tap",
        "right_click",
        "hover",
        "scroll",
        "type",
        "keys",
        "menu",
        "long_press",
        "drag"
      ]
    },
    "windowID": {
      "type": "integer",
      "minimum": 1
    },
    "x": {
      "type": "number",
      "minimum": 0
    },
    "y": {
      "type": "number",
      "minimum": 0
    },
    "dx": {
      "type": "number",
      "minimum": -10000,
      "maximum": 10000
    },
    "dy": {
      "type": "number",
      "minimum": -10000,
      "maximum": 10000
    },
    "text": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 1
    },
    "path": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "clear": {
      "type": "boolean"
    },
    "submit": {
      "type": "boolean"
    },
    "points": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "description": "A drag's path in window points, first to last.",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "description": "How long a long press holds, or a drag takes, in milliseconds."
    },
    "clicks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "A tap's click count: 2 is a double click."
    },
    "item": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "A right click's context-menu item to choose; without it, the menu's items are answered and nothing is chosen."
    }
  },
  "required": [
    "kind",
    "windowID"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/AndrewKochulab/sim-mirror/main/protocol/app-sdk/v1/input.schema.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "tap",
              "right_click",
              "hover",
              "long_press"
            ]
          }
        }
      },
      "then": {
        "required": [
          "x",
          "y"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "scroll"
            ]
          }
        }
      },
      "then": {
        "required": [
          "x",
          "y",
          "dx",
          "dy"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "type",
              "keys"
            ]
          }
        }
      },
      "then": {
        "required": [
          "text"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "menu"
            ]
          }
        }
      },
      "then": {
        "required": [
          "path"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "drag"
            ]
          }
        }
      },
      "then": {
        "required": [
          "points"
        ]
      }
    }
  ]
}
