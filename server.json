{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.AndrewKochulab/sim-mirror",
  "title": "SimMirror",
  "description": "Drive iOS Simulators, iPhones, Android devices and macOS apps: UI snapshots, live viewer, recording.",
  "version": "3.4.0",
  "websiteUrl": "https://github.com/AndrewKochulab/sim-mirror#readme",
  "repository": {
    "url": "https://github.com/AndrewKochulab/sim-mirror",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "sim-mirror",
      "version": "3.4.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
